            </index_of_refraction>
          </phong>
          <extra>
            <technique profile="FCOLLADA">
              <bump>
                <texture texture="model_nut8_png-sampler" texcoord="GeometrySource2"/>
              </bump>
            </technique>
          </extra>
        </technique>
        <extra>
          <technique profile="GOOGLEEARTH">
            <double_sided>1</double_sided>
          </technique>
        </extra>
      </profile_COMMON>
      <extra><technique profile="MAX3D"><double_sided>1</double_sided></technique></extra>
    </effect>
